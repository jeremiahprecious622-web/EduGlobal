rules_version = '2';

// ==========================================================
// EduGlobal - Firestore Security Rules (Live classes update)
// Everything is blocked unless a rule below allows it.
// Times are UTC. Nigeria time (WAT) is UTC + 1, so
// 5:00 PM to 8:00 PM WAT is 16:00 to 19:00 UTC.
// ==========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helper functions ----------
    function signedIn() { return request.auth != null; }
    function isVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // THE ONLY ADMINISTRATOR. Paste your own User UID from Firebase, Authentication, Users.
    // Even if another account is ever given the superadmin role, only this one works.
    function founderUid() { return '7WfOT5N4CUfnb58gp8o9UGDjgdX2'; }
    function isSuperAdmin() { return isVerified() && request.auth.uid == founderUid() && me().role == 'superadmin'; }
    function isStudent() { return isVerified() && me().role == 'student' && me().status == 'active'; }
    function canTeach() { return isVerified() && me().role in ['teacher', 'superadmin'] && me().status == 'active'; }

    // Monday, Thursday or Friday (counted from the day number since 1970, when day 0 was a Thursday)
    function dayOk() { return (math.floor(request.time.toMillis() / 86400000) + 4) % 7 in [1, 4, 5]; }
    // Classroom access: students of the subject, the assigned teacher, or the administrator
    function inRoom(subject) { return isStudent() && me().subjects.hasAny([subject]); }
    function teachesSubject(subject) {
      return canTeach() && (isSuperAdmin()
        || (get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.status == 'active'
            && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.subjects.hasAny([subject])));
    }

    function inLiveWindow() { return dayOk() && request.time.hours() >= 16 && request.time.hours() < 19; }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['fullName','email','country','curriculum','level','subjects',
              'role','status','consentAt','createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 60
        && request.resource.data.curriculum is string
        && request.resource.data.level is string
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() >= 1
        && request.resource.data.subjects.size() <= 15
        && request.resource.data.consentAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName','country','curriculum','level','subjects']);

      allow delete: if false;
    }

    // ---------- teachers (created and managed by the super admin) ----------
    match /teachers/{uid} {
      allow read: if isVerified() && (isSuperAdmin() || request.auth.uid == uid);
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['fullName','email','subjects','status','isFounder','createdAt'])
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() <= 15
        && request.resource.data.status in ['active', 'suspended'];
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subjects', 'status'])
        && request.resource.data.subjects.size() <= 15
        && request.resource.data.status in ['active', 'suspended'];
      allow delete: if isSuperAdmin();
    }

    // ---------- classes (the timetable, created by the super admin) ----------
    match /classes/{classId} {
      allow read: if isSuperAdmin() || isStudent()
        || (canTeach() && resource.data.teacherUid == request.auth.uid);

      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(
             ['subject','title','teacherUid','teacherName','day','start','end','active','mode','createdAt'])
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 60
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.teacherUid is string
        && request.resource.data.teacherName is string && request.resource.data.teacherName.size() <= 80
        && request.resource.data.day in [1, 2, 3, 4, 5, 6]
        && request.resource.data.mode in ['live', 'room']
        // live = Google Meet days (Mon, Thu, Fri). room = classroom days (Tue, Wed, Sat) ending by 7:00 PM
        && ((request.resource.data.mode == 'live' && request.resource.data.day in [1, 4, 5])
            || (request.resource.data.mode == 'room' && request.resource.data.day in [2, 3, 6]
                && request.resource.data.end <= '19:00'))
        && request.resource.data.start.matches('^1[7-9]:[0-5][0-9]$')
        && (request.resource.data.end.matches('^1[7-9]:[0-5][0-9]$') || request.resource.data.end == '20:00')
        && request.resource.data.start < request.resource.data.end
        && request.resource.data.active is bool
        // the teacher must exist and be assigned to this subject
        && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherUid))
        && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherUid))
             .data.subjects.hasAny([request.resource.data.subject]);

      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if isSuperAdmin();
    }

    // ---------- live sessions (written ONLY when a teacher starts a lesson) ----------
    match /liveSessions/{classId} {

      allow read: if isVerified() && (
        resource == null
        || (canTeach() && (resource.data.teacherUid == request.auth.uid || isSuperAdmin()))
        || (isStudent() && inLiveWindow() && me().subjects.hasAny([resource.data.subject]))
      );

      allow create: if startOk(classId, request.resource.data);
      allow update: if startOk(classId, request.resource.data) || endOk();
      allow delete: if false;

      function classOf(id) { return get(/databases/$(database)/documents/classes/$(id)).data; }

      // Starting a lesson: the teacher owns the class, it is a class day and time,
      // and the link is a real Google Meet link.
      function startOk(id, d) {
        return canTeach()
          && classOf(id).teacherUid == request.auth.uid
          && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.status == 'active'
          && inLiveWindow()
          && d.keys().hasOnly(['classId','subject','title','teacherUid','teacherName','meetLink','status','startedAt'])
          && d.classId == id
          && d.subject == classOf(id).subject
          && d.teacherUid == request.auth.uid
          && d.status == 'live'
          && d.startedAt == request.time
          && d.title is string && d.title.size() <= 80
          && d.teacherName is string && d.teacherName.size() <= 80
          && d.meetLink is string
          && d.meetLink.matches('^https://meet[.]google[.]com/[a-zA-Z0-9/_?=&.-]{3,80}$');
      }

      // Ending a lesson: also removes the link
      function endOk() {
        return canTeach()
          && resource.data.teacherUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt','meetLink'])
          && request.resource.data.status == 'ended'
          && request.resource.data.endedAt == request.time
          && request.resource.data.meetLink == '';
      }
    }

    // ---------- classrooms: lessons and chat, one room per subject ----------
    match /rooms/{subject}/lessons/{id} {
      allow read: if isSuperAdmin() || inRoom(subject) || teachesSubject(subject);
      allow create: if teachesSubject(subject)
        && request.resource.data.keys().hasOnly(['title','body','videoUrl','teacherUid','teacherName','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() >= 10 && request.resource.data.body.size() <= 4000
        && request.resource.data.videoUrl is string
        && (request.resource.data.videoUrl == ''
            || request.resource.data.videoUrl.matches('^https://(www[.])?(youtube[.]com/watch[?]v=|youtu[.]be/)[A-Za-z0-9_-]{11}([&?].*)?$'))
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherName == me().fullName
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if teachesSubject(subject);
    }

    match /rooms/{subject}/messages/{id} {
      allow read: if isSuperAdmin() || inRoom(subject) || teachesSubject(subject);
      allow create: if (inRoom(subject) || teachesSubject(subject))
        && request.resource.data.keys().hasOnly(['text','authorUid','authorName','role','createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == me().fullName
        && request.resource.data.role == me().role
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if teachesSubject(subject) || (isVerified() && resource.data.authorUid == request.auth.uid);
    }

    // ---------- settings ----------
    //   contact   : public contact details (anyone can read)
    //   liveClass : old single Meet link (kept, no longer used by the dashboard)
    //   whatsapp  : WhatsApp links (verified, logged-in users can read)
    match /settings/{docId} {
      allow read: if docId == 'contact'
                  || (isVerified() && docId in ['liveClass', 'whatsapp']);
      allow write: if isSuperAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
